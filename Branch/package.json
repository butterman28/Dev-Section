{
  "name": "branch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel tailwind:watch esbuild:watch tauri:dev",
    "tauri:dev": "tauri dev",
    "tauri": "tauri",
    "build": "npm-run-all tailwind:build esbuild:build tauri:build",
    "tauri:build": "tauri build",
    "tailwind:watch": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "tailwind:build": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "esbuild:watch": "esbuild src/main.js --bundle --platform=browser --format=esm --outfile=src/app.js --watch",
    "esbuild:build": "esbuild src/main.js --bundle --platform=browser --format=esm --outfile=src/app.js --minify"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.18",
    "tauri-plugin-clipboard-api": "^2.1.11"
  }
}
